# miniNBLM 0.1.4 default 12B all-in-one image.
MININBLM_IMAGE_VERSION=0.1.4
MININBLM_ALL_IN_ONE_IMAGE=cpsu/mininblm:0.1.4

# Public Hugging Face model repository pinned to an immutable commit SHA.
MODEL_HF_REPO_ID=PLMQ2785/Gemma-4-12B-it-W4A16
MODEL_HF_REVISION=5001828f23191ed64c94e9e57ef58fc3b45fa492
VLLM_MODEL_PATH=/data/models/gemma4

NATIVE_DB_NAME=rag_db
NATIVE_DB_USER=rag_user
NATIVE_DB_PASSWORD=change-this-database-password
MININBLM_DB_PORT=5433
MAX_UPLOAD_BYTES=52428800
MAX_REQUEST_BODY_BYTES=53477376

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODE=embedding
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_DEVICE=cuda
RERANKER_DTYPE=float16
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
VLLM_MODEL_NAME=gemma4
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.60
VLLM_MAX_NUM_SEQS=4
VLLM_CPU_OFFLOAD_GB=0
VLLM_TENSOR_PARALLEL_SIZE=1
MININBLM_LLM_CONFIG_FILE=./config/llm-endpoints.json

MAX_UPLOAD_BYTES=52428800
VISION_CAPTION_MODE=disabled
VISION_CAPTION_DPI=144
VISION_CAPTION_VERSION=gemma4-page-caption-v1
READINESS_TIMEOUT_SECONDS=3
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
