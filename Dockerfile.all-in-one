FROM vllm/vllm-openai:v0.25.0

USER root

COPY --from=ghcr.io/astral-sh/uv:0.9.28 /uv /uvx /bin/

ARG MININBLM_MODEL_VARIANT=gemma4-12b-w4a16
ARG MININBLM_MODEL_DISPLAY_NAME="Gemma 4 12B W4A16"
ARG MININBLM_LLM_CONFIG_SOURCE=config/llm-endpoints.json
ARG MININBLM_IMAGE_VERSION=0.1.4
LABEL org.opencontainers.image.version="${MININBLM_IMAGE_VERSION}" \
      io.mininblm.model.variant="${MININBLM_MODEL_VARIANT}" \
      io.mininblm.model.display-name="${MININBLM_MODEL_DISPLAY_NAME}" \
      io.mininblm.model.bundled="false" \
      io.mininblm.model.delivery="remote-archive"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv-native \
    PATH="/app/.venv-native/bin:/usr/lib/postgresql/17/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg patch tar util-linux \
    && install -d -m 0755 /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt jammy-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-17 postgresql-client-17 postgresql-17-pgvector \
    && rm -rf /var/lib/apt/lists/*

RUN pg_dropcluster --stop 17 main >/dev/null 2>&1 || true

COPY docker/vllm-gemma4-unified-quant.patch /tmp/vllm-gemma4-unified-quant.patch
RUN patch --forward --batch \
        /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/gemma4_unified.py \
        /tmp/vllm-gemma4-unified-quant.patch \
    && sed -i \
        's/self.embed_vision.embedding_projection.weight.dtype/self.embed_vision.embedding_projection.params_dtype/g' \
        /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/gemma4_unified.py \
    && ! grep -q \
        'self.embed_vision.embedding_projection.weight.dtype' \
        /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/gemma4_unified.py \
    && rm -f /tmp/vllm-gemma4-unified-quant.patch

WORKDIR /app

COPY pyproject.toml uv.lock ./
# Reuse the CUDA 13 Torch runtime already supplied by the pinned vLLM image.
# Installing the embedding lock first preserves its validated Python dependencies;
# removing only its CUDA 12 runtime in this same layer avoids a second 5+ GB stack.
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv venv --system-site-packages "${UV_PROJECT_ENVIRONMENT}" \
    && UV_CACHE_DIR=/tmp/uv-cache uv sync \
        --frozen --only-group api --only-group embedding --no-install-project \
    && uv pip uninstall --python "${UV_PROJECT_ENVIRONMENT}/bin/python" \
        torch triton \
        nvidia-cublas-cu12 nvidia-cuda-cupti-cu12 nvidia-cuda-nvrtc-cu12 \
        nvidia-cuda-runtime-cu12 nvidia-cudnn-cu12 nvidia-cufft-cu12 \
        nvidia-cufile-cu12 nvidia-curand-cu12 nvidia-cusolver-cu12 \
        nvidia-cusparse-cu12 nvidia-cusparselt-cu12 nvidia-nccl-cu12 \
        nvidia-nvjitlink-cu12 nvidia-nvtx-cu12 \
    && "${UV_PROJECT_ENVIRONMENT}/bin/python" -c \
        'import sentence_transformers, torch; assert torch.__version__ == "2.11.0+cu130"; assert torch.version.cuda == "13.0"; assert torch.__file__.startswith("/usr/local/")'

COPY app ./app
COPY ${MININBLM_LLM_CONFIG_SOURCE} ./config/llm-endpoints.default.json
COPY embedding_service ./embedding_service
COPY alembic ./alembic
COPY alembic.ini .
COPY .env.example ./.env.example
COPY run-native.sh ./run-native.sh
COPY docker/all-in-one-entrypoint.sh /usr/local/bin/all-in-one-entrypoint
COPY docker/prepare-model.sh /usr/local/bin/prepare-model
COPY backup.sh restore.sh ./
COPY scripts/backup.sh scripts/restore.sh ./scripts/


RUN chmod +x /app/run-native.sh /app/backup.sh /app/restore.sh \
        /app/scripts/backup.sh /app/scripts/restore.sh \
        /usr/local/bin/all-in-one-entrypoint /usr/local/bin/prepare-model \
    && : > /app/.env \
    && mkdir -p /data/config /data/models /data/model-cache /data/postgres /data/uploads /data/huggingface /data/logs /data/backups /run/mininblm

ENV NATIVE_ENV_DIR=/app/.venv-native \
    NATIVE_VLLM_BIN=/usr/local/bin/vllm \
    NATIVE_MANAGE_DB=true \
    NATIVE_START_EMBEDDING=true \
    NATIVE_START_LLM=true \
    NATIVE_DB_DATA_DIR=/data/postgres \
    NATIVE_RUNTIME_DIR=/run/mininblm \
    NATIVE_LOG_DIR=/data/logs \
    NATIVE_UPLOAD_DIR=/data/uploads \
    RUNTIME_MODE=native \
    BACKUP_DIR=/data/backups \
    UPLOADS_DIR=/data/uploads \
    NATIVE_API_HOST=0.0.0.0 \
    NATIVE_API_PORT=8080 \
    NATIVE_EMBEDDING_PORT=8070 \
    NATIVE_LLM_PORT=8010 \
    NATIVE_LLM_HEALTH_URL=http://127.0.0.1:8010/v1/models \
    HF_HOME=/data/huggingface \
    VLLM_MODEL_PATH=/data/models/gemma4 \
    EMBEDDING_BASE_URL=http://127.0.0.1:8070 \
    LLM_ENDPOINTS_FILE=/data/config/llm-endpoints.json \
    STARTUP_TIMEOUT=1800

VOLUME ["/data"]
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=300s --retries=10 \
    CMD curl -fsS http://127.0.0.1:8080/health/ready >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/all-in-one-entrypoint"]
