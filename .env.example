MININBLM_DB_PORT=5433
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5433/rag_db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800

EMBEDDING_BASE_URL=http://localhost:8070
EMBEDDING_MODEL=BAAI/bge-m3

LLM_ENDPOINTS_FILE=./config/llm-endpoints.json
VISION_CAPTION_MODE=disabled
VISION_CAPTION_DPI=144
VISION_CAPTION_VERSION=gemma4-page-caption-v1
READINESS_TIMEOUT_SECONDS=3
VLLM_MODEL_PATH=./google/gemma-4-12B-it-W4A16
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.65
VLLM_MAX_NUM_SEQS=4

# Native runtime (no nested containers)
NATIVE_MANAGE_DB=true
NATIVE_START_EMBEDDING=true
NATIVE_START_LLM=true
NATIVE_DB_NAME=rag_db
NATIVE_DB_USER=rag_user
NATIVE_DB_PASSWORD=rag_password
NATIVE_DB_OS_USER=postgres
NATIVE_DB_DATA_DIR=./.native/postgres
NATIVE_RUNTIME_DIR=./.native/run
NATIVE_LOG_DIR=./.native/logs
NATIVE_UPLOAD_DIR=./.native/uploads
NATIVE_ENV_DIR=.venv-native
NATIVE_VLLM_ENV_DIR=.venv-vllm
NATIVE_VLLM_VERSION=0.25.0
NATIVE_API_HOST=0.0.0.0
NATIVE_API_PORT=8080
NATIVE_EMBEDDING_PORT=8070
NATIVE_LLM_PORT=8010
# Set this when NATIVE_START_LLM=false and the JSON file uses a remote endpoint.
NATIVE_LLM_HEALTH_URL=http://localhost:8010/v1/models

AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO
# Set both values only when creating the initial administrator account.
# The administrator must replace this temporary password at first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
