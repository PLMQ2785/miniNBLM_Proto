# Gemma 4 31B QAT W4A16 all-in-one variant. Default: one NVIDIA H200 GPU.
MININBLM_IMAGE_VERSION=0.1.5
MININBLM_ALL_IN_ONE_IMAGE=cpsu/mininblm:0.1.5-gemma4-31b-w4a16
MININBLM_MODEL_VARIANT=gemma4-31b-w4a16
MININBLM_MODEL_DISPLAY_NAME=Gemma 4 31B W4A16

# Direct-download URL for a .tar/.tar.gz 31B model archive and its SHA-256.
# The archive may contain model files at root or inside one top-level directory.
MODEL_ARCHIVE_URL=https://drive.usercontent.google.com/download?id=1sRf_b2PflYVmzF-deNmjoT8NL1Y_W373&export=download&confirm=t
MODEL_ARCHIVE_SHA256=1a28093ac67542780473b4c74f659fb3988d7c69e1fbf974772b2ab94c0f6ebf
MODEL_KEEP_ARCHIVE=false
VLLM_MODEL_PATH=/data/models/gemma4

NATIVE_DB_NAME=rag_db
NATIVE_DB_USER=rag_user
NATIVE_DB_PASSWORD=change-this-database-password
MININBLM_DB_PORT=5433

# H200 has enough headroom to run BGE-M3 on GPU beside one vLLM instance.
# VLLM_MAX_NUM_SEQS limits concurrently active sequences, not total users.
# A single RTX 3090 24GB was insufficient in an observed startup attempt.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
VLLM_MODEL_NAME=gemma4
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_NUM_SEQS=8
VLLM_CPU_OFFLOAD_GB=0
VLLM_TENSOR_PARALLEL_SIZE=1
MININBLM_LLM_CONFIG_FILE=./config/llm-endpoints-31b.json

MAX_UPLOAD_BYTES=52428800
MAX_REQUEST_BODY_BYTES=53477376
VISION_CAPTION_MODE=disabled
VISION_CAPTION_DPI=144
VISION_CAPTION_VERSION=gemma4-31b-page-caption-v1
READINESS_TIMEOUT_SECONDS=3
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
